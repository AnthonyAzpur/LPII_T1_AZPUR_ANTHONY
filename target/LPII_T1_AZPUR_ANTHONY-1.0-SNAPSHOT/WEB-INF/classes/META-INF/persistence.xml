<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
  <persistence-unit name="LPII_PU" transaction-type="RESOURCE_LOCAL">
    <!-- Entidades -->
    <class>com.cibertec.model.Cliente</class>
    <class>com.cibertec.model.Pelicula</class>
    <class>com.cibertec.model.Alquiler</class>
    <class>com.cibertec.model.DetalleAlquiler</class>

    <properties>
      <!-- Conexión a MySQL (XAMPP) -->
            <property name="javax.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/mi_base_jpa?serverTimezone=UTC"/>
            <property name="javax.persistence.jdbc.user" value="root"/>
            <property name="javax.persistence.jdbc.password" value=""/> <!-- Por defecto XAMPP no tiene contraseña -->
            <property name="javax.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
